# What `git archive` leaves out of a release download (.github/workflows/release.yml):
# the development tooling. A user runs the app; the tests, the CI and the linters'
# settings stay in the repository.
.github/            export-ignore
tests/              export-ignore
frontend/tests/     export-ignore
benchmarks/         export-ignore
tools/              export-ignore
.gitleaksignore     export-ignore
eslint.config.mjs   export-ignore
.graphifyignore     export-ignore
pyproject.toml      export-ignore
requirements-dev.txt export-ignore
requirements-docs.txt export-ignore
mkdocs.yml          export-ignore

# Writes the commit and the tag into a download, which has no .git to ask
# (core/version.py).
core/version.py     export-subst

# Shell scripts keep LF on every checkout, Windows' too: bash reads a CR as part of
# the command it ends.
*.sh                text eol=lf

# A recorded Kratos run of a GUI tutorial (tests/fakes/replay_kratos.py): kept byte for
# byte as Kratos wrote it, on every checkout.
tests/fixtures/tutorial_runs/** -text

# The UDSM soil libraries (core/model/udsm_libraries): compiled code, never diffed or merged as text.
*.dll               binary
*.so                binary
