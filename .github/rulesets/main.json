{
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "pull_request"
    }
  ],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "required_status_checks": [
          { "context": "windows-latest / Python 3.11", "integration_id": 15368 },
          { "context": "ubuntu-latest / Python 3.11", "integration_id": 15368 },
          { "context": "windows-latest / Python 3.13", "integration_id": 15368 },
          { "context": "launcher windows-latest / Python 3.10", "integration_id": 15368 },
          { "context": "launcher windows-latest / Python 3.13", "integration_id": 15368 },
          { "context": "launcher ubuntu-latest / Python 3.10", "integration_id": 15368 },
          { "context": "launcher ubuntu-latest / Python 3.13", "integration_id": 15368 },
          { "context": "launcher macos-latest / Python 3.10", "integration_id": 15368 },
          { "context": "launcher macos-latest / Python 3.13", "integration_id": 15368 },
          { "context": "ruff", "integration_id": 15368 },
          { "context": "eslint", "integration_id": 15368 },
          { "context": "actionlint", "integration_id": 15368 },
          { "context": "pip-audit", "integration_id": 15368 },
          { "context": "gitleaks", "integration_id": 15368 }
        ]
      }
    }
  ]
}
