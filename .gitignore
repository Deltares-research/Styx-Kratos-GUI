# Virtual environments contain platform-specific executables and native libraries.
/.venv/
/.venv-*/
# The venv from before the move, until it is deleted (restructure Step 7).
.venv/
.venv-*/
/.data/
/styx-public.git/

# Which python runs Kratos, and where its build is: one machine's answer, not the
# project's. See core/analysis/calculation.py.
/kratos.local.json

plan/
# Code graph build output stays local; the committed code map is in docs/developer/code-map/.
graphify-out/
# Local snapshot of the frozen mockup (index.html + css/js/vendor/assets).
mockup/
# Old mockup locations; the app uses frontend/base/.
/css/
/js/

AGENTS.md

# Python and test caches
__pycache__/
.pytest_cache/
*.py[cod]
# Package metadata that an editable install (pip install -e .) writes.
*.egg-info/

# Coverage output (pytest --cov, and the JS summary from --js-coverage)
/.coverage
/.coverage.*
/htmlcov/
/htmlcov-js/
# Benchmark runs and reports (python -m benchmarks run, from the repository root)
/benchmarks/reports/
# Playwright traces kept for failed tests (--tracing retain-on-failure)
/test-results/

# Crash dumps Git for Windows tools write into the working folder (grep.exe.stackdump).
*.stackdump

# The GUI tutorials: screenshots made by tools/gui_tutorial.py and by CI, never committed.
/build/
# ... and in docs/gui_tutorials/images/, where the site build reads them.
/docs/gui_tutorials/images/
