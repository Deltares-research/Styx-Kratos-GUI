# Virtual environments contain platform-specific executables and native libraries.
server/.venv/
server/.venv-*/
server/.data/

# Which python runs Kratos, and where its build is: one machine's answer, not the
# project's. See server/app/calculate.py.
server/kratos.local.json

plan/
graphify-out/

# Reference decks and example models. `examples/crow/` holds the CROW staged-excavation
# case: the model script the GUI runs (`run examples/crow/crow.py`), the deck Kratos is
# validated against (`crow_validation_*`, copied from the GeoMechanicsApplication test
# suite), and what STEM generates for the same model (`*_for_generated_mesh`,
# `crow_excavation_wall.mdpa`, `demo_crow_excavation_wall.py`).
#
# Out of the repository because they belong to another project and are large -- the two
# .mdpa files alone are 700 KB of node tables. `server/tests/crow_example.py` skips the
# tests that need them when they are not there, so a clone without them still runs green.
examples/
AGENTS.md
test/

# Python and test caches
__pycache__/
.pytest_cache/
*.py[cod]
