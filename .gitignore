# Virtual environments contain platform-specific executables and native libraries.
server/.venv/
server/.venv-*/
server/.data/

# Which python runs Kratos, and where its build is: one machine's answer, not the
# project's. See server/app/calculate.py.
server/kratos.local.json

plan/
graphify-out/
# Local snapshot of the frozen mockup (index.html + css/js/vendor/assets).
mockup/
# Old mockup locations; the app uses live/base/.
/css/
/js/

AGENTS.md

# Python and test caches
__pycache__/
.pytest_cache/
*.py[cod]

# Coverage output (pytest --cov, and the JS summary from --js-coverage)
server/.coverage
server/.coverage.*
server/htmlcov/
server/htmlcov-js/
# Benchmark runs and reports (python -m benchmarks run, from server/)
server/benchmarks/reports/
# Playwright traces kept for failed tests (--tracing retain-on-failure)
server/test-results/
